# Ogham stones in Wikidata with coordinate, findspot (P189), current
# location (P276), collection (P195) and country (P17).
# Feeds layers (a) and (b) of the Ancestors case (step S3).
SELECT ?item ?itemLabel ?coord ?findspot ?findspotLabel ?location ?locationLabel
       ?collection ?collectionLabel ?country ?countryLabel WHERE {
  ?item wdt:P31 wd:Q2016147 .
  OPTIONAL { ?item wdt:P625 ?coord . }
  OPTIONAL { ?item wdt:P189 ?findspot . }
  OPTIONAL { ?item wdt:P276 ?location . }
  OPTIONAL { ?item wdt:P195 ?collection . }
  OPTIONAL { ?item wdt:P17 ?country . }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
