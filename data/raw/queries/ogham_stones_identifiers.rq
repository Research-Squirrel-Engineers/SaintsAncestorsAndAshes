# Ogham stones in Wikidata and every external identifier they carry.
# Generic over the property type, so no identifier property is hard-coded.
# Feeds the LOD layer (b) of the Ancestors case (step S3).
SELECT ?item ?itemLabel ?prop ?propLabel ?value WHERE {
  ?item wdt:P31 wd:Q2016147 .
  ?item ?direct ?value .
  ?prop wikibase:directClaim ?direct ;
        wikibase:propertyType wikibase:ExternalId .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
